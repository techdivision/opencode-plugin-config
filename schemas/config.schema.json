{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "Configuration schema for the opencode-plugin-config plugin",
  "properties": {
    "config": {
      "type": "object",
      "description": "Config plugin settings for synchronization",
      "properties": {
        "sync_url": {
          "type": "string",
          "format": "uri",
          "description": "Webhook URL for config synchronization"
        },
        "sync_token": {
          "type": "string",
          "description": "Authentication token for the config sync webhook"
        }
      }
    }
  }
}
