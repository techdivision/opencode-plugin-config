{
  "name": "@techdivision/opencode-plugin-config",
  "version": "0.1.0",
  "description": "OpenCode Plugin - Configuration cascade with deep-merge, env-var resolution and schema validation",
  "type": "module",
  "main": "src/config.ts",
  "types": "src/config.ts",
  "files": [
    "src/",
    "skills/",
    "schemas/",
    "plugin.json"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "config",
    "config-sync",
    "deep-merge",
    "schema-validation",
    "webhook",
    "plugin-system"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:acceptance": "vitest run tests/acceptance",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techdivision/opencode-plugin-config.git"
  },
  "homepage": "https://github.com/techdivision/opencode-plugin-config#readme",
  "bugs": {
    "url": "https://github.com/techdivision/opencode-plugin-config/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.2.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "deepmerge": "^4.3.1",
    "semver": "^7.7.4"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.15.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1",
    "yaml": "^2.8.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "opencode": {
    "plugin": true,
    "category": "optional"
