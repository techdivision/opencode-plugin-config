# Config Sync Webhook
CONFIG_SYNC_URL=https://n8n.example.com/webhook/config-builder
CONFIG_SYNC_BEARER_TOKEN=your-webhook-token-here
CONFIG_SYNC_CONFIG_KEY=YOURPROJECT

# Optional: comma-separated plugin sections (overrides auto-discovery)
# CONFIG_SYNC_PLUGINS=jira,time-tracking

# User identification (sent as the "user" field in the webhook payload)
OPENCODE_USER_EMAIL=your.email@example.com
